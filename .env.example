# ─── Discord ────────────────────────────────────────────────────────────────
# Token bota (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=twoj_token_tutaj

# ID aplikacji (Developer Portal -> General Information -> Application ID)
CLIENT_ID=twoje_client_id

# Opcjonalne: ID serwera testowego. Jesli ustawione, `npm run deploy`
# rejestruje komendy tylko na tym serwerze (natychmiast, zamiast ~1h).
GUILD_ID=opcjonalne_guild_id

# ─── Baza danych ────────────────────────────────────────────────────────────
# Sciezka do pliku SQLite (tworzony automatycznie przy pierwszym starcie)
DATABASE_PATH=./data/nlbot.db

# ─── Bot ────────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info

# Zapis logow bota takze do pliku (logs/bot-RRRR-MM-DD.log, rotacja dzienna)
LOG_TO_FILE=false
LOG_DIR=./logs
LOG_RETENTION_DAYS=14

# Wymaga wlaczenia "Presence Intent" w Developer Portal.
# Gdy true, /stats pokazuje liczbe osob online.
ENABLE_PRESENCE_INTENT=false

# ID uzytkownikow z pelnym dostepem do komend bota (po przecinku), opcjonalne
OWNER_IDS=twoje_discord_id
